# --- GCP / Vertex AI (never commit a real .env) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIM=768

# --- Agent service DB (investigations, pending actions, knowledge chunks) ---
DATABASE_URL=postgresql+asyncpg://ir:ir@localhost:5432/ir_agent

# --- IR backend (mock locally; the real service layer in prod) ---
IR_BACKEND_URL=http://localhost:9000
IR_BACKEND_TOKEN=dev-token

APP_ENV=local
LOG_LEVEL=INFO
